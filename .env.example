DATABASE_URL="postgresql://cdmvote:cdmvote@localhost:5432/cdmvote?schema=public"
REDIS_URL="redis://localhost:6379"

# Session signing secret (JWT) — generate a real random value for prod, e.g. `openssl rand -base64 32`
SESSION_SECRET="dev-only-change-me"

# Seeded on first `prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
